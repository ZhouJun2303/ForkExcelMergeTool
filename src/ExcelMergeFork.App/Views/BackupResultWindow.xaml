<ui:FluentWindow x:Class="ExcelMergeFork.App.Views.BackupResultWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 Title="快速备份"
                 Width="820" Height="520"
                 WindowStartupLocation="CenterScreen"
                 Icon="pack://application:,,,/Assets/ExcelMergeFork.ico"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="Mica">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <ui:TitleBar Title="快速备份模式">
            <ui:TitleBar.Icon>
                <ui:ImageIcon Source="pack://application:,,,/Assets/app_32.png"/>
            </ui:TitleBar.Icon>
        </ui:TitleBar>
        <Grid Grid.Row="1" Margin="20,8,20,8">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <TextBlock x:Name="Headline" FontSize="22" FontWeight="SemiBold"/>
            <TextBlock x:Name="Detail" Grid.Row="1" TextWrapping="Wrap" Margin="0,8,0,12" Opacity="0.75"/>
            <ui:DataGrid x:Name="FilesGrid" Grid.Row="2" AutoGenerateColumns="False" IsReadOnly="True"
                         CanUserAddRows="False" HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                         BorderThickness="0">
                <ui:DataGrid.Columns>
                    <DataGridTextColumn Header="类型" Binding="{Binding Label}" Width="140"/>
                    <DataGridTextColumn Header="备份文件" Binding="{Binding Path}" Width="*"/>
                </ui:DataGrid.Columns>
            </ui:DataGrid>
        </Grid>
        <DockPanel Grid.Row="2" Margin="20,0,20,16">
            <ui:Button DockPanel.Dock="Right" Appearance="Secondary" Content="关闭" Click="OnClose"/>
            <ui:Button Appearance="Primary" Content="打开目录" Click="OnOpen"/>
        </DockPanel>
    </Grid>
</ui:FluentWindow>
