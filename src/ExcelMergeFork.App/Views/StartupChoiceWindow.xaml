<Window x:Class="ExcelMergeFork.App.Views.StartupChoiceWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="选择运行模式"
        Icon="pack://application:,,,/Assets/ExcelMergeFork.ico"
        Width="760" Height="560"
        MinWidth="640" MinHeight="420"
        WindowStartupLocation="CenterScreen"
        Background="#F4F7FB">
    <Grid Margin="0">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <StackPanel Grid.Row="0" Margin="24">
            <TextBlock x:Name="TitleText" FontSize="22" FontWeight="SemiBold"/>
            <TextBlock x:Name="NoticeText" Opacity="0.75" TextWrapping="Wrap" Margin="0,8,0,16"/>
            <DataGrid x:Name="FilesGrid" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column" Height="220">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="角色" Binding="{Binding Role}" Width="120"/>
                    <DataGridTextColumn Header="文件" Binding="{Binding Name}" Width="180"/>
                    <DataGridTextColumn Header="大小" Binding="{Binding Size}" Width="90"/>
                    <DataGridTextColumn Header="路径" Binding="{Binding Path}" Width="*"/>
                </DataGrid.Columns>
            </DataGrid>
            <TextBlock x:Name="WarnText" Foreground="#B91C1C" TextWrapping="Wrap" Margin="0,12,0,0"/>
        </StackPanel>
        <Border Grid.Row="1" Padding="20,12" Background="White" BorderBrush="#E5E7EB" BorderThickness="0,1,0,0">
            <DockPanel LastChildFill="False">
                <Button DockPanel.Dock="Left" Content="取消" Click="OnCancel" Padding="16,8" MinWidth="88"/>
                <Button DockPanel.Dock="Right" Content="进入合并/对比" x:Name="MergeButton" Click="OnMerge" Padding="16,8" MinWidth="120" Margin="8,0,0,0"/>
                <Button DockPanel.Dock="Right" Content="快速备份" Click="OnBackup" Padding="16,8" MinWidth="100"/>
            </DockPanel>
        </Border>
    </Grid>
</Window>
