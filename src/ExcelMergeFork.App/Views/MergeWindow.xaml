<ui:FluentWindow x:Class="ExcelMergeFork.App.Views.MergeWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 Title="Excel 三向合并"
                 Width="1520" Height="820"
                 MinWidth="1180" MinHeight="640"
                 Icon="pack://application:,,,/Assets/ExcelMergeFork.ico"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="Mica">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" MinWidth="680"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <ui:TitleBar Title="Excel 三向合并" Grid.Row="0" Grid.ColumnSpan="2">
            <ui:TitleBar.Icon>
                <ui:ImageIcon Source="pack://application:,,,/Assets/app_32.png"/>
            </ui:TitleBar.Icon>
        </ui:TitleBar>

        <Grid Grid.Row="1" Grid.Column="0" ClipToBounds="True">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="2*" MinHeight="96"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*" MinHeight="96"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="20,8,20,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" MinWidth="0"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Margin="0,0,12,0">
                    <TextBlock Text="Excel 三向合并" FontSize="22" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                    <TextBlock Text="{Binding LocalCommit}" Opacity="0.75" Margin="0,4,0,0"
                               TextTrimming="CharacterEllipsis" ToolTip="{Binding LocalCommit}"/>
                    <TextBlock Text="{Binding RemoteCommit}" Opacity="0.75"
                               TextTrimming="CharacterEllipsis" ToolTip="{Binding RemoteCommit}"/>
                    <TextBlock Text="{Binding TargetPath}" Opacity="0.55" Margin="0,2,0,0"
                               TextTrimming="CharacterEllipsis" ToolTip="{Binding TargetPath}"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                    <ui:Button Appearance="Secondary" x:Name="AiToggleButton" Content="收起 AI 合并" Click="ToggleAiPanel" Padding="12,6" Margin="0,0,8,0"/>
                    <ui:Button Appearance="Secondary" Content="设置中心" Click="OpenSettings" Padding="12,6"/>
                </StackPanel>
            </Grid>

            <ScrollViewer Grid.Row="1" Margin="20,12,20,8" MaxHeight="188"
                          VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <Border Padding="12" CornerRadius="8" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}">
                    <StackPanel>
                        <WrapPanel>
                            <TextBlock Text="基准侧" VerticalAlignment="Center" Margin="0,0,8,8"/>
                            <ComboBox Width="140" Margin="0,0,0,8" SelectedValue="{Binding BaseSide}" SelectedValuePath="Tag">
                                <ComboBoxItem Content="本地 Local" Tag="local" IsSelected="True"/>
                                <ComboBoxItem Content="线上 Remote" Tag="remote"/>
                            </ComboBox>
                            <CheckBox Content="跳过新增行" IsChecked="{Binding SkipNewRows}" Margin="16,0,0,8"/>
                            <CheckBox Content="跳过新增列" IsChecked="{Binding SkipNewColumns}" Margin="12,0,0,8"/>
                            <CheckBox Content="删除缺失行" IsChecked="{Binding DeleteMissingRows}" Margin="12,0,0,8"/>
                            <CheckBox Content="删除缺失列" IsChecked="{Binding DeleteMissingColumns}" Margin="12,0,0,8"/>
                            <CheckBox Content="追加新 Sheet" IsChecked="{Binding AddNewSheets}" Margin="12,0,0,8"/>
                            <CheckBox Content="删除缺失 Sheet" IsChecked="{Binding DeleteMissingSheets}" Margin="12,0,0,8"/>
                            <CheckBox Content="处理冲突" IsChecked="{Binding ResolveConflicts}" Margin="12,0,0,8"/>
                        </WrapPanel>
                        <Grid Margin="0,2,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" MinWidth="0"/>
                                <ColumnDefinition Width="180"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Grid VerticalAlignment="Center" Margin="0,0,8,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*" MinWidth="0"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="当前 Sheet：" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1" Text="{Binding CurrentSheetName}" FontWeight="SemiBold"
                                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                           ToolTip="{Binding CurrentSheetName}"/>
                                <TextBlock Grid.Column="2" Text="{Binding SheetProgressText}" Opacity="0.7"
                                           VerticalAlignment="Center" Margin="8,0,0,0"/>
                            </Grid>
                            <ui:TextBox Grid.Column="1" VerticalAlignment="Center" PlaceholderText="搜索键或工作表" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}">
                                <ui:TextBox.Icon>
                                    <ui:SymbolIcon Symbol="Search24"/>
                                </ui:TextBox.Icon>
                            </ui:TextBox>
                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0,0,0">
                                <ui:Button Appearance="Secondary" Content="上一个 Sheet" Command="{Binding PreviousSheetCommand}" IsEnabled="{Binding CanGoPrevious}" Padding="10,4" Margin="0,0,6,0"/>
                                <ui:Button Appearance="Secondary" Content="下一个 Sheet" Command="{Binding NextSheetCommand}" IsEnabled="{Binding CanGoNext}" Padding="10,4" Margin="0,0,6,0"/>
                                <ui:Button Appearance="Secondary" Content="确认本 Sheet" Command="{Binding FinishCurrentSheetCommand}" IsEnabled="{Binding CanFinishCurrentSheet}" Padding="10,4"/>
                            </StackPanel>
                        </Grid>
                        <TextBlock Text="{Binding SummaryText}" Opacity="0.7" Margin="0,8,0,0" TextWrapping="Wrap"/>
                        <TextBlock Text="{Binding CurrentSheetStatusText}" Opacity="0.7" Margin="0,4,0,0" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>
            </ScrollViewer>

            <ui:DataGrid x:Name="MergeGrid" Grid.Row="2" Margin="20,0,20,0"
                         ItemsSource="{Binding ItemsView}"
                         SelectedItem="{Binding SelectedItem}"
                         AutoGenerateColumns="False"
                         CanUserAddRows="False"
                         CanUserDeleteRows="False"
                         IsReadOnly="True"
                         CanUserSortColumns="False"
                         CanUserReorderColumns="False"
                         HeadersVisibility="Column"
                         GridLinesVisibility="Horizontal"
                         BorderThickness="0"
                         SelectionMode="Single"
                         SelectionUnit="FullRow"
                         EnableRowVirtualization="True"
                         EnableColumnVirtualization="False"
                         VirtualizingPanel.IsVirtualizing="True"
                         VirtualizingPanel.VirtualizationMode="Recycling"
                         ScrollViewer.CanContentScroll="True"
                         ScrollViewer.HorizontalScrollBarVisibility="Auto"
                         RowHeight="48">
                <ui:DataGrid.Columns>
                    <DataGridTemplateColumn Header="类型" Width="96">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Border x:Name="Badge" CornerRadius="6" Padding="8,3" HorizontalAlignment="Left" VerticalAlignment="Center"
                                        Background="{StaticResource TagModifyBrush}">
                                    <TextBlock x:Name="Label" Text="{Binding TypeLabel}" FontWeight="SemiBold"
                                               Foreground="{StaticResource TagModifyFgBrush}"/>
                                </Border>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding Tag}" Value="New">
                                        <Setter TargetName="Badge" Property="Background" Value="{StaticResource TagNewBrush}"/>
                                        <Setter TargetName="Label" Property="Foreground" Value="{StaticResource TagNewFgBrush}"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Tag}" Value="Delete">
                                        <Setter TargetName="Badge" Property="Background" Value="{StaticResource TagDeleteBrush}"/>
                                        <Setter TargetName="Label" Property="Foreground" Value="{StaticResource TagDeleteFgBrush}"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Tag}" Value="Info">
                                        <Setter TargetName="Badge" Property="Background" Value="{StaticResource TagDeleteBrush}"/>
                                        <Setter TargetName="Label" Property="Foreground" Value="{StaticResource TagDeleteFgBrush}"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Tag}" Value="Conflict">
                                        <Setter TargetName="Badge" Property="Background" Value="{StaticResource TagConflictBrush}"/>
                                        <Setter TargetName="Label" Property="Foreground" Value="{StaticResource TagConflictFgBrush}"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Tag}" Value="DeleteConflict">
                                        <Setter TargetName="Badge" Property="Background" Value="{StaticResource TagConflictBrush}"/>
                                        <Setter TargetName="Label" Property="Foreground" Value="{StaticResource TagConflictFgBrush}"/>
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="工作表" Binding="{Binding Sheet}" Width="140">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource GridCellText}">
                                <Setter Property="ToolTip" Value="{Binding Sheet}"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="键" Binding="{Binding Key}" Width="*">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource GridCellText}">
                                <Setter Property="ToolTip" Value="{Binding Key}"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="处理" Binding="{Binding Action}" Width="*">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource GridCellText}">
                                <Setter Property="Opacity" Value="0.75"/>
                                <Setter Property="ToolTip" Value="{Binding Action}"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTemplateColumn Header="选择" Width="156">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                    <ui:Button Appearance="Secondary" Content="本地"
                                               Command="{Binding DataContext.ChooseLocalCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                               CommandParameter="{Binding}" IsEnabled="{Binding CanChoose}" Margin="0,0,6,0" Padding="10,2"/>
                                    <ui:Button Appearance="Secondary" Content="线上"
                                               Command="{Binding DataContext.ChooseRemoteCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                               CommandParameter="{Binding}" IsEnabled="{Binding CanChoose}" Padding="10,2"/>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </ui:DataGrid.Columns>
            </ui:DataGrid>

            <Grid Grid.Row="3" Height="12" Margin="20,0">
                <Border Height="1" VerticalAlignment="Center" Opacity="0.5"
                        Background="{DynamicResource ControlStrokeColorDefaultBrush}"/>
                <GridSplitter HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Background="Transparent"
                              ResizeDirection="Rows" ShowsPreview="False"/>
            </Grid>

            <Grid x:Name="MergePreview" Grid.Row="4" Margin="20,0,20,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" MinWidth="80"/>
                    <ColumnDefinition Width="*" MinWidth="80"/>
                    <ColumnDefinition Width="*" MinWidth="80"/>
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Margin="0,0,6,0" Padding="12" CornerRadius="8" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" Text="BASE" FontWeight="SemiBold" Margin="0,0,0,8"/>
                        <ItemsControl ItemsSource="{Binding SelectedItem.BaseDisplay}" Style="{StaticResource VirtualList}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}" TextWrapping="Wrap" Margin="0,2"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </DockPanel>
                </Border>
                <Border Grid.Column="1" Margin="3,0" Padding="12" CornerRadius="8" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" Text="LOCAL" FontWeight="SemiBold" Margin="0,0,0,8"/>
                        <ItemsControl ItemsSource="{Binding SelectedItem.LocalDisplay}" Style="{StaticResource VirtualList}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}" TextWrapping="Wrap" Margin="0,2"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </DockPanel>
                </Border>
                <Border Grid.Column="2" Margin="6,0,0,0" Padding="12" CornerRadius="8" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" Text="REMOTE" FontWeight="SemiBold" Margin="0,0,0,8"/>
                        <ItemsControl ItemsSource="{Binding SelectedItem.RemoteDisplay}" Style="{StaticResource VirtualList}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}" TextWrapping="Wrap" Margin="0,2"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </DockPanel>
                </Border>
                <TextBlock Grid.ColumnSpan="3" Text="选择上方的一行，查看 BASE、LOCAL、REMOTE。"
                           HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.65" IsHitTestVisible="False">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SelectedItem}" Value="{x:Null}">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Grid>

            <Grid Grid.Row="5" Margin="20,0,20,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" MinWidth="0"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding StatusText}" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,12,0"/>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <ui:Button Appearance="Secondary" Content="取消" Click="OnCancel" Margin="0,0,8,0" Padding="16,8"/>
                    <ui:Button Appearance="Secondary" Content="生成合并结果" Click="OnGenerate" IsEnabled="{Binding CanAttemptGenerate}" Padding="16,8" Margin="0,0,8,0"/>
                    <ui:Button Appearance="Primary" Content="确认并解决冲突" Click="OnConfirm" IsEnabled="{Binding CanConfirm}" Padding="16,8"/>
                </StackPanel>
            </Grid>
        </Grid>

        <Border x:Name="AiPanel" Grid.Row="1" Grid.Column="1" Width="400" Margin="0,8,16,16" Padding="14"
                CornerRadius="8" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" MaxHeight="168">
                    <StackPanel>
                        <TextBlock Text="AI 合并" FontSize="18" FontWeight="SemiBold"/>
                        <TextBlock Text="勾选当前冲突仓库里要交给 AI 的 Excel。每条下面是文件路径。"
                                   Opacity="0.75" TextWrapping="Wrap" Margin="0,6,0,0"/>
                        <TextBlock Text="{Binding AiRepoText}" TextWrapping="Wrap" Opacity="0.8" Margin="0,8,0,0"/>
                        <TextBlock Text="{Binding AiSummaryText}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                    </StackPanel>
                </ScrollViewer>
                <ListView Grid.Row="1" ItemsSource="{Binding AiFiles}" BorderThickness="0" Margin="0,8,0,0"
                          ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                          ScrollViewer.VerticalScrollBarVisibility="Auto"
                          ScrollViewer.CanContentScroll="False"
                          VirtualizingPanel.IsVirtualizing="True"
                          VirtualizingPanel.VirtualizationMode="Recycling">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            <Setter Property="Padding" Value="2,4"/>
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="0,4">
                                <CheckBox IsChecked="{Binding IsChecked}" FontWeight="SemiBold">
                                    <TextBlock Text="{Binding RelativePath}" TextWrapping="Wrap"/>
                                </CheckBox>
                                <TextBlock Text="{Binding FullPath}" Margin="22,3,0,0" Opacity="0.8" TextWrapping="Wrap"/>
                                <TextBlock Text="{Binding ExtraPathText}" Margin="22,2,0,0" Opacity="0.7" TextWrapping="Wrap"/>
                                <TextBlock Margin="22,2,0,0" Opacity="0.65" TextWrapping="Wrap">
                                    <Run Text="{Binding StatusLabel, Mode=OneWay}"/>
                                    <Run Text="  "/>
                                    <Run Text="{Binding SidesText, Mode=OneWay}"/>
                                </TextBlock>
                            </StackPanel>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
                <StackPanel Grid.Row="2" Margin="0,8,0,0">
                    <TextBlock Text="复制后会关闭本窗口，方便 AI 读取这些文件。" Opacity="0.65" TextWrapping="Wrap" Margin="0,0,0,6"/>
                    <TextBlock Text="{Binding AiStatusText}" TextWrapping="Wrap" Opacity="0.75" Margin="0,0,0,8"/>
                    <WrapPanel>
                        <ui:Button Appearance="Secondary" Content="刷新" Command="{Binding RefreshAiFilesCommand}" Padding="10,6" Margin="0,0,6,6"/>
                        <ui:Button Appearance="Secondary" Content="全选" Command="{Binding CheckAllAiFilesCommand}" Padding="10,6" Margin="0,0,6,6"/>
                        <ui:Button Appearance="Secondary" Content="全不选" Command="{Binding UncheckAllAiFilesCommand}" Padding="10,6" Margin="0,0,6,6"/>
                    </WrapPanel>
                    <WrapPanel>
                        <ui:Button Appearance="Secondary" Content="复制路径给 AI" Click="CopySelectedPathsToAi" IsEnabled="{Binding CanUseAi}" Padding="10,6" Margin="0,0,6,6"/>
                        <ui:Button Appearance="Secondary" Content="复制冲突给 AI" Click="CopySelectedConflictsToAi" IsEnabled="{Binding CanUseAi}" Padding="10,6" Margin="0,0,6,6"/>
                    </WrapPanel>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</ui:FluentWindow>
