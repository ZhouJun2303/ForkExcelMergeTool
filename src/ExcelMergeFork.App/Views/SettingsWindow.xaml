<ui:FluentWindow x:Class="ExcelMergeFork.App.Views.SettingsWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 Title="ExcelMergeFork 设置中心"
                 Width="980" Height="720"
                 MinWidth="820" MinHeight="600"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="Mica">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <ui:TitleBar Title="ExcelMergeFork 设置中心" Grid.Row="0"/>
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <ListBox x:Name="Nav" Grid.Column="0" BorderThickness="0" SelectionChanged="OnNavChanged" Margin="8">
                <ListBoxItem Content="常规" Tag="general" IsSelected="True"/>
                <ListBoxItem Content="备份" Tag="backup"/>
                <ListBoxItem Content="Fork" Tag="fork"/>
                <ListBoxItem Content="Git" Tag="git"/>
                <ListBoxItem Content="更新" Tag="update"/>
            </ListBox>
            <ScrollViewer Grid.Column="1" Padding="28,16,28,24">
                <StackPanel x:Name="PageHost" MaxWidth="720" HorizontalAlignment="Left"/>
            </ScrollViewer>
        </Grid>
    </Grid>
</ui:FluentWindow>
