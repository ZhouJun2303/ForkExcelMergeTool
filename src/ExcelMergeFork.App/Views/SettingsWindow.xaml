<ui:FluentWindow x:Class="ExcelMergeFork.App.Views.SettingsWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 Title="ExcelMergeFork 设置中心"
                 Width="980" Height="720"
                 MinWidth="820" MinHeight="600"
                 Icon="pack://application:,,,/Assets/ExcelMergeFork.ico"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="Mica">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <ui:TitleBar Title="ExcelMergeFork 设置中心" Grid.Row="0">
            <ui:TitleBar.Icon>
                <ui:ImageIcon Source="pack://application:,,,/Assets/app_32.png"/>
            </ui:TitleBar.Icon>
        </ui:TitleBar>
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" Margin="16,8,8,16" Padding="8" CornerRadius="8"
                    Background="{DynamicResource CardBackgroundFillColorDefaultBrush}">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="设置" FontWeight="SemiBold" Margin="10,8,10,10"/>
                    <ListBox x:Name="Nav" BorderThickness="0" Background="Transparent" SelectionChanged="OnNavChanged">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Padding" Value="12,8"/>
                                <Setter Property="Margin" Value="0,2"/>
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBoxItem Content="常规" Tag="general" IsSelected="True"/>
                        <ListBoxItem Content="备份" Tag="backup"/>
                        <ListBoxItem Content="Fork" Tag="fork"/>
                        <ListBoxItem Content="Git" Tag="git"/>
                        <ListBoxItem Content="更新" Tag="update"/>
                    </ListBox>
                </DockPanel>
            </Border>
            <ScrollViewer Grid.Column="1" Padding="28,16,28,24" HorizontalScrollBarVisibility="Disabled">
                <StackPanel x:Name="PageHost" MaxWidth="720" HorizontalAlignment="Stretch"/>
            </ScrollViewer>
        </Grid>
    </Grid>
</ui:FluentWindow>
