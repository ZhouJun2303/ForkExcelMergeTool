<Application x:Class="ExcelMergeFork.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             ShutdownMode="OnExplicitShutdown"
             Startup="OnStartup">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ui:ThemesDictionary Theme="Light" />
                <ui:ControlsDictionary />
            </ResourceDictionary.MergedDictionaries>
            <SolidColorBrush x:Key="TagNewBrush" Color="#DCFCE7"/>
            <SolidColorBrush x:Key="TagNewFgBrush" Color="#15803D"/>
            <SolidColorBrush x:Key="TagDeleteBrush" Color="#EEF2F7"/>
            <SolidColorBrush x:Key="TagDeleteFgBrush" Color="#64748B"/>
            <SolidColorBrush x:Key="TagModifyBrush" Color="#FEF3C7"/>
            <SolidColorBrush x:Key="TagModifyFgBrush" Color="#B45309"/>
            <SolidColorBrush x:Key="TagConflictBrush" Color="#FEE2E2"/>
            <SolidColorBrush x:Key="TagConflictFgBrush" Color="#B91C1C"/>
            <SolidColorBrush x:Key="AccentBrush" Color="#2563EB"/>
        </ResourceDictionary>
    </Application.Resources>
</Application>
